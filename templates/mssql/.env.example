# mssql-dba-mcp connection settings.
# Your .env was created from this file: fill in your values there.
# The MCP server reads ./.env itself when Claude Code starts it in this folder.
# Keep comments on their own lines: text after a value is part of the value.

# sql = SQL Server login, windows = Windows / NTLM login.
# Both need DB_USER and DB_PASSWORD (NTLM cannot reuse your logged-in session).
DB_AUTH_TYPE=sql

DB_HOST=localhost
DB_NAME=master
# A read-only login, never sa. The server refuses to start with sa or any
# sysadmin, CONTROL SERVER or db_owner login. Setup script:
# https://github.com/shadow-dba/mssql-dba-mcp#permissions
DB_USER=shadow-dba
DB_PASSWORD=YourStrongPasswordHere

# --- Optional ---------------------------------------------------------------
# DB_PORT=1433
# Windows auth with a domain account only:
# DB_DOMAIN=
# ENCRYPT=true
# true only for a self-signed certificate on a trusted network:
# TRUST_SERVER_CERTIFICATE=false
# REQUEST_TIMEOUT=30000
# MAX_POOL=10
# MIN_POOL=0
# IDLE=30000
# Run with a privileged login anyway (not recommended):
# MSSQL_ALLOW_PRIVILEGED_LOGIN=false
